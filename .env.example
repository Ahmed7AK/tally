# Copy to `.env.local` and fill in from your Supabase project:
#   Project Settings → Data API  (URL)
#   Project Settings → API Keys  (anon / publishable key)
#
# The anon key is safe in a client bundle — row-level security is what protects
# the data, and supabase/schema.sql sets it up.
#
# Leave both unset to run Tally as a local-only tracker: no sign-in gate, no
# sync, everything stays in this browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
